{
  "name": "jofiel-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "duplicates": "jscpd",
    "check": "prettier --check . && npm run lint && npm run typecheck && npm run duplicates",
    "preview": "vite preview",
    "heaven-sent": "node scripts/heaven-sent.ts"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "lucide-react": "^0.462.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.18.5",
    "remark-frontmatter": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^15.15.0",
    "jscpd": "^5.4.3",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "~7.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "overrides": {
    "eslint-plugin-sonarjs": {
      "minimatch": "^11.0.9"
    }
  }
}
